# Copy this file to .env and adjust. Environment variables override these values.
SENSAI_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
# Optional persona used at startup: the name of a file of SENSAI_PERSONAS_DIR without .json
# (investigator, fact_checker, editor). Empty: no persona, SENSAI_SYSTEM_PROMPT is used.
SENSAI_PERSONA=
# Folder of the persona files (default: the personas/ folder of the repository).
SENSAI_PERSONAS_DIR=
# System prompt sent at the start of every conversation when no persona is active.
SENSAI_SYSTEM_PROMPT=
SENSAI_NUM_CTX=8192
SENSAI_THINK=
# Condense the oldest turns once the context reaches this percentage of SENSAI_NUM_CTX.
SENSAI_COMPACT_THRESHOLD=75
# Number of most recent turns always kept verbatim.
SENSAI_KEEP_RECENT_TURNS=4
# Every conversation is saved there (python -m sensai --resume to continue it).
SENSAI_SESSIONS_DIR=.sensai/sessions
# Your standing instructions, one per line, sent at the start of every conversation (/profile add TEXT).
SENSAI_PROFILE_PATH=.sensai/profile.md
# Long-term memory: the facts and relations the model saves about people, companies and places.
SENSAI_MEMORY_PATH=.sensai/memory.db
# Rules checking your messages, the answers and the tool calls (copy guardrails.example.json there).
SENSAI_GUARDRAILS_PATH=.sensai/guardrails.json
# URLs of the MCP servers whose tools the model can call (copy mcp.example.json there).
SENSAI_MCP_PATH=.sensai/mcp.json

# Features, each on by default: false turns it off (also /feature NAME on|off in the chat).
SENSAI_FEATURE_RAG=true
# false disables every tool below, whatever their own setting.
SENSAI_FEATURE_TOOLS=true
# Let the model search the web with Ollama's web search API. Off by default: queries leave the machine.
# Needs a model that supports tools (qwen3, llama3.1...) and a free API key from https://ollama.com/settings/keys
SENSAI_FEATURE_WEB_SEARCH=false
# Let the model run the Python code it writes in a Docker container (no network, limited memory and CPU).
# Off by default: needs Docker installed and running.
SENSAI_FEATURE_CODE_EXEC=false
# Let the model list, read and write files, only in the folders below. Off by default: it touches files on this machine.
SENSAI_FEATURE_FILES=false
# Let the model save and look up facts in SENSAI_MEMORY_PATH, kept between sessions. Stays on this machine.
SENSAI_FEATURE_MEMORY=true
# Let the model call the tools of the MCP servers listed in SENSAI_MCP_PATH. Without the file, no server is reached.
SENSAI_FEATURE_MCP=true
# Let the model ask you a question when your request is ambiguous, instead of guessing. Off when nobody answers.
SENSAI_FEATURE_QUESTIONS=true
# Save every conversation in SENSAI_SESSIONS_DIR (python -m sensai --resume to continue it).
SENSAI_FEATURE_SESSIONS=true
# Send the instructions of SENSAI_PROFILE_PATH at the start of every conversation.
SENSAI_FEATURE_PROFILE=true
# Keep a working document of the established facts, updated after every answer (/document). One more model call per answer.
SENSAI_FEATURE_DOCUMENT=true
# Check your messages, the answers and the tool calls against the rules of SENSAI_GUARDRAILS_PATH.
SENSAI_FEATURE_GUARDRAILS=true
# Let /review have the investigator's answer checked by the fact-checker, then written by the editor.
SENSAI_FEATURE_ORCHESTRATION=true

SENSAI_EMBED_MODEL=qwen3-embedding:0.6b
SENSAI_INDEX_PATH=.sensai/index.db
SENSAI_RAG_TOP_K=5
SENSAI_RAG_CHUNK_SIZE=1200
SENSAI_RAG_CHUNK_OVERLAP=200

OLLAMA_API_KEY=
# Results the model gets for each web search (1-10).
SENSAI_WEB_SEARCH_RESULTS=5
# Seconds a program may run before it is stopped (1-60).
SENSAI_CODE_TIMEOUT=10
# Docker image the code runs in. Use an image with pandas to analyse CSV files.
SENSAI_SANDBOX_IMAGE=python:3.12-slim
# Seconds an MCP server may take to answer a tool call (1-300).
SENSAI_MCP_TIMEOUT=30
# Folders the model may read, and the ones it may also write in, separated by commas (/files to check them).
SENSAI_FILES_READ=.
SENSAI_FILES_WRITE=
# Names never readable nor writable inside these folders. .env, .sensai and .git always are.
SENSAI_FILES_DENY=
# Rounds of tool calls allowed per message before the model has to answer (1-20).
SENSAI_MAX_TOOL_ROUNDS=5
# Checks by the fact-checker in a /review before it stops without the editor (1-5).
SENSAI_MAX_REVIEW_ROUNDS=2
# When to ask before running a tool: critical (tools that send data out or run code), all, or off.
SENSAI_APPROVAL=critical
